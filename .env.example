# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Phase 1 — required to run anything ---
# Get a key at https://aistudio.google.com/apikey — never paste the real value
# anywhere but this local file (not into chat, not into a commit).
GEMINI_API_KEY=

# --- Phase 2 — required once real integrations are wired in ---
ABUSEIPDB_API_KEY=
SLACK_WEBHOOK_URL=

# --- Phase 3 — required once the GraphRAG layer is wired in ---
VOYAGE_API_KEY=
# Using Neo4j Aura (free tier) — get these from console.neo4j.io when you
# create an AuraDB Free instance. URI looks like neo4j+s://xxxx.databases.neo4j.io
# (NOT bolt://localhost — that's for local Docker, which this project isn't using).
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Optional overrides (sensible defaults apply if unset) ---
# gemini-3.6-flash is the default because it's genuinely ACCESSIBLE to this
# API key/project (may differ for yours) — NOT because it's exempt from the
# free tier's 20 requests/day cap. It hit that same cap too after heavy
# same-day testing (a single Aegis run makes up to 4 Gemini calls). Also
# ruled out for this key: gemini-2.5-flash -> 404 "no longer available to
# new users". If you're testing heavily in one day, expect to hit the daily
# cap on any current free-tier Gemini model — a paid tier removes it.
# Verify against https://ai.google.dev/gemini-api/docs/models before relying
# on any of these — Gemini's model lineup moves fast.
AEGIS_MODEL=gemini-3.6-flash
AEGIS_TEMPERATURE=0.0
