# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Phase 1 — required to run anything ---
# Get a key at https://aistudio.google.com/apikey — never paste the real value
# anywhere but this local file (not into chat, not into a commit).
GEMINI_API_KEY=

# --- Phase 2 — required once real integrations are wired in ---
ABUSEIPDB_API_KEY=
SLACK_WEBHOOK_URL=

# --- Phase 3 — required once the GraphRAG layer is wired in ---
VOYAGE_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Optional overrides (sensible defaults apply if unset) ---
# Verify the current model ID against https://ai.google.dev/gemini-api/docs/models
# before relying on this default — Gemini's model lineup moves fast.
AEGIS_MODEL=gemini-3.7-flash
AEGIS_TEMPERATURE=0.0
